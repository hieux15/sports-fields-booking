# PostgreSQL connection string (example uses Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# HTTP port the NestJS server listens on
PORT=3000

# Secret used to sign JWT access tokens - replace with a long random string
# Must be at least 32 characters, otherwise the app refuses to start.
JWT_SECRET="replace-with-a-long-random-hex-string"

# Access token lifetime, any value accepted by jsonwebtoken ("7d", "12h", ...)
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed by CORS (Next.js dev server)
CORS_ORIGIN=http://localhost:3001

# Swagger UI is served at /docs (JSON at /docs-json). Set to false to disable it.
SWAGGER_ENABLED=true
