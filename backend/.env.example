# PostgreSQL connection string (example uses Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# HTTP port the NestJS server listens on
PORT=3000

# Secret used to sign JWT access tokens
JWT_SECRET="replace-with-a-long-random-hex-string"

# Access token lifetime
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGIN=http://localhost:3001

# Swagger UI is served at /docs
SWAGGER_ENABLED=true

# Public origin of this API. Only used to build image links when court photos are
# written to the local disk 
PUBLIC_BASE_URL=http://localhost:3000

# Max size of one court photo, in bytes (default 5242880 = 5MB)
UPLOAD_MAX_BYTES=5242880

# Fill in both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to store court photos
# in Supabase Storage. Leave them empty and photos go to backend/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=court-images
