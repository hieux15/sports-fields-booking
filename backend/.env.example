# PostgreSQL connection string (example uses Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# HTTP port the NestJS server listens on
PORT=3000

# Secret used to sign JWT access tokens - replace with a long random string
# Must be at least 32 characters, otherwise the app refuses to start.
JWT_SECRET="replace-with-a-long-random-hex-string"

# Access token lifetime, any value accepted by jsonwebtoken ("7d", "12h", ...)
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed by CORS (Next.js dev server)
CORS_ORIGIN=http://localhost:3001

# Swagger UI is served at /docs (JSON at /docs-json). Set to false to disable it.
SWAGGER_ENABLED=true

# Public origin of this API. Only used to build image links when court photos are
# written to the local disk (backend/uploads); set it to the real domain in
# production. Supabase Storage driver ignores it.
PUBLIC_BASE_URL=http://localhost:3000

# Max size of one court photo, in bytes (default 5242880 = 5MB)
UPLOAD_MAX_BYTES=5242880

# --- Court photo storage (optional) -----------------------------------------
# Fill in both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to store court photos
# in Supabase Storage. Leave them empty and photos go to backend/uploads
# instead (lost on redeploy, so it is only meant for local development).
# The bucket must exist and be public, e.g. create "court-images" in
# Dashboard -> Storage, or: POST {SUPABASE_URL}/storage/v1/bucket
#   Authorization: Bearer <SERVICE_ROLE_KEY>
#   { "id": "court-images", "name": "court-images", "public": true }
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=court-images
