generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  courts   Court[]
  bookings Booking[]
  reviews  Review[]
}

model Court {
  id           String    @id @default(uuid())
  name         String
  // Enum thay cho text tự do: filter `GET /courts?type=` là so sánh đúng-một-giá-trị
  // ở database, client không cần normalise/bỏ dấu khi so sánh.
  type         SportType
  address      String?
  // Ảnh thật do chủ sân tải lên (Supabase Storage hoặc backend/uploads). Null
  // nghĩa là client tự dùng ảnh minh hoạ theo loại sân.
  imageUrl     String?
  pricePerHour Decimal
  openTime     String
  closeTime    String
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  bookings     Booking[]
  reviews      Review[]
  avgRating    Float?

  @@index([ownerId])
}

model Booking {
  id           String        @id @default(uuid())
  courtId      String
  court        Court         @relation(fields: [courtId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  startTime    DateTime
  endTime      DateTime
  status       BookingStatus @default(PENDING)
  // Snapshot giá tại thời điểm đặt: chủ sân đổi giá sau đó cũng không ghi
  // lại được doanh thu của các đơn cũ.
  pricePerHour Decimal
  totalPrice   Decimal
  createdAt    DateTime      @default(now())

  @@index([courtId, startTime, endTime])
  // Phục vụ GET /bookings/me (lọc theo userId, sắp xếp theo startTime desc).
  @@index([userId, startTime])
}

model Review {
  id        String    @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  courtId   String
  createdAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id])
  court     Court     @relation(fields: [courtId], references: [id])

  @@unique([userId, courtId])
  @@index([courtId])
}

enum Role {
  OWNER
  CUSTOMER
}

// Loại sân — key ổn định để hiển thị tiếng Việt nằm ở client (court-type.ts).
enum SportType {
  FOOTBALL
  BADMINTON
  TENNIS
  PICKLEBALL
  BASKETBALL
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  // Đơn PENDING quá giờ bắt đầu mà chủ sân chưa xác nhận (cron tự chuyển).
  EXPIRED
  // Đơn CONFIRMED đã qua giờ kết thúc — lịch sử doanh thu (cron tự chuyển).
  COMPLETED
}
